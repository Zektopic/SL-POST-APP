<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup="false" already disables cloud backup, but on API 31+
    it does NOT disable device-to-device transfer. The session cookie lives in
    the WebView profile directory and the sign-in state in slp_state.xml, so
    both are excluded from transfer explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="slp_state.xml" />
        <exclude domain="file" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="slp_state.xml" />
        <exclude domain="file" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
