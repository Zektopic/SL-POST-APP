<?xml version="1.0" encoding="utf-8"?>
<!--
    Governs auto-backup on API <= 30. Backup is disabled outright via
    android:allowBackup="false"; these excludes are belt-and-braces so that
    re-enabling backup cannot silently start uploading the signed-in session.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="slp_state.xml" />
    <exclude domain="file" path="app_webview/" />
</full-backup-content>
