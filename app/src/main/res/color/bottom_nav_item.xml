<?xml version="1.0" encoding="utf-8"?>
<!--
    The bottom bar's background is a fixed white (md_surface_container_lowest)
    in both themes, so its foreground must be pinned too. Left to inherit,
    it picked up colorOnSurfaceVariant, which resolves to md_on_surface_variant_dark
    (#E1BEBE) at night - pale pink icons and labels on a white bar.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/md_primary" android:state_checked="true" />
    <item android:color="@color/md_on_surface_variant" />
</selector>
