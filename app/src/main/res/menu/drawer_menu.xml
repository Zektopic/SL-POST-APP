<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawer: account actions and the site's information pages.
    Primary navigation (Home / Browse / Cart / Account) is the bottom bar.
    MainActivity.updateAuthMenuState() shows one of the two account groups.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <group android:id="@+id/group_auth_guest">
        <item
            android:id="@+id/navigation_login"
            android:icon="@drawable/ic_login"
            android:title="@string/nav_login" />
        <item
            android:id="@+id/navigation_signup"
            android:icon="@drawable/ic_signup"
            android:title="@string/nav_signup" />
    </group>

    <group android:id="@+id/group_auth_user">
        <item
            android:id="@+id/navigation_account"
            android:icon="@drawable/ic_account"
            android:title="@string/nav_my_account"
            android:visible="false" />
        <item
            android:id="@+id/navigation_logout"
            android:icon="@drawable/ic_logout"
            android:title="@string/nav_logout"
            android:visible="false" />
    </group>

    <group android:id="@+id/group_info">
        <item
            android:id="@+id/navigation_payment_methods"
            android:icon="@drawable/ic_payment"
            android:title="@string/nav_payment_methods" />
        <item
            android:id="@+id/navigation_standing_order"
            android:icon="@drawable/ic_help"
            android:title="@string/nav_standing_orders" />
        <item
            android:id="@+id/navigation_downloads"
            android:icon="@drawable/ic_download"
            android:title="@string/nav_downloads" />
        <item
            android:id="@+id/navigation_general_info"
            android:icon="@drawable/ic_info"
            android:title="@string/nav_general_info" />
        <item
            android:id="@+id/navigation_terms"
            android:icon="@drawable/ic_terms"
            android:title="@string/nav_terms" />
        <item
            android:id="@+id/navigation_contact"
            android:icon="@drawable/ic_contact"
            android:title="@string/nav_contact" />
    </group>

</menu>
